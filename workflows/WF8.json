    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "df32e49d-fa46-4c42-a69a-40b8b5fb2ac8",
              "name": "leads_summary",
              "value": "={{ (() => { const L = $('איחוד לידים').first().json.leads.filter(x => x.fields); return 'מתעניינים: ' + L.length + ' | ' + [...new Set(L.map(x => String(x.fields.Status || '').trim() || 'ללא'))].map(s => s + ': ' + L.filter(x => (String(x.fields.Status || '').trim() || 'ללא') === s).length).join(', '); })() }}",
              "type": "string"
            },
            {
              "id": "a6565197-9c72-43f2-8892-7fcd17dad6da",
              "name": "apts_summary",
              "value": "={{ (() => { const N = s => String(s || '').replace(/[^\\u05D0-\\u05EA]/g, ''); const F = (x, name) => { const k = Object.keys(x.fields).find(k => k.toLowerCase().includes(name)); const v = k ? x.fields[k] : ''; const w = Array.isArray(v) ? v[0] : v; return (w && w.name) || w || ''; }; const A = $('איחוד דירות').first().json.apts.filter(x => x.fields && F(x, 'apartmentid') && F(x, 'apartmentid') !== 'ApartmentId'); const S = x => N(F(x, 'status')); const st = (p, s) => A.filter(x => F(x, 'project') === p && S(x) === N(s)).length; return 'סה\"כ דירות: ' + A.length + ' | ' + [...new Set(A.map(x => F(x, 'project')))].map(p => p + ' – פנויות: ' + st(p,'פנויה') + ', שמורות: ' + st(p,'שמורה') + ', נמכרו: ' + st(p,'נמכרה')).join(' | ') + '\\nדירות פנויות: ' + A.filter(x => S(x) === N('פנויה')).map(x => F(x, 'apartmentid') + ' (' + F(x, 'project') + ', ' + F(x, 'rooms') + ' חדרים, ' + Number(F(x, 'price')).toLocaleString('he-IL') + ' ש\"ח)').join('; '); })() }}",
              "type": "string"
            },
            {
              "id": "faa9fbdf-e739-40a8-9825-e6c2a2aee6a5",
              "name": "pays_summary",
              "value": "={{ (() => { const P = $('איחוד תשלומים').first().json.pays.filter(x => x.fields); const sent = P.filter(x => String(x.fields.Status || '').trim() === 'נשלח'); const sum = sent.reduce((s, x) => s + Number(x.fields.Total || 0), 0); return 'דרישות תשלום: ' + P.length + ' | נשלחו: ' + sent.length + ' בסך ' + sum.toLocaleString('he-IL') + ' ש\"ח כולל מע\"מ | ממתינות להפקה: ' + P.filter(x => String(x.fields.Status || '').trim() === 'חדש').length; })() }}",
              "type": "string"
            },
            {
              "id": "970f4fdd-a8d7-4fe0-beef-e8e8d99f78ae",
              "name": "tasks_summary",
              "value": "={{ (() => { const T = $('איחוד משימות').first().json.tasks.filter(x => x.fields).filter(x => String(x.fields.Status || '').trim() !== 'סגורה'); return 'משימות פתוחות: ' + T.length + (T.length ? '\\n' + T.map(x => '- ' + x.fields.Title).join('\\n') : ''); })() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
