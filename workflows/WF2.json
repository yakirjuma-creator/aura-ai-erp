        "filterByFormula": "=AND({Status }=\"פנויה\", {Rooms}&\"\"=\"{{ $json.fields.Rooms }}\", {Price}<={{ Math.round($json.fields.Budget * 1.1) }}{{ $json.fields.Project && $json.fields.Project !== 'לא משנה' ? ', {Project}=\"' + $json.fields.Project + '\"' : '' }})",
